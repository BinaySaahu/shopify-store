SHOPIFY_STORE_DOMAIN=shopify-store-domain
SHOPIFY_STOREFRONT_ACCESS_TOKEN=shopify-storefront-access-token
GROQ_API_KEY=groq-api-key
GROQ_MODEL=model-name #you can change this to any model you want to use, but it must be a model that is compatible with the Groq API. For example, you can use "openai/gpt-oss-120b".
